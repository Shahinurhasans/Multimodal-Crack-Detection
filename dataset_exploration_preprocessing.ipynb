
import os
import numpy as np
import pandas as pd
import torch
import torch.nn.functional as F
import librosa
from PIL import Image
from torch.utils.data import Dataset, DataLoader
from torchvision import transforms
from sklearn.model_selection import train_test_split

from config import cfg


# Transforms 

IMAGE_TRANSFORM_TRAIN = transforms.Compose([
    transforms.Resize((cfg.IMG_SIZE, cfg.IMG_SIZE)),
    transforms.RandomHorizontalFlip(),
    transforms.RandomVerticalFlip(),
    transforms.RandomRotation(15),
    transforms.ColorJitter(brightness=0.3, contrast=0.3, saturation=0.2),
    transforms.ToTensor(),
    transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),
])

IMAGE_TRANSFORM_VAL = transforms.Compose([
    transforms.Resize((cfg.IMG_SIZE, cfg.IMG_SIZE)),
    transforms.ToTensor(),
    transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),
])


#  Audio helpers 

def audio_to_spectrogram(audio_path: str) -> torch.Tensor:
    y, sr = librosa.load(audio_path, sr=cfg.SAMPLE_RATE)
    spec = librosa.feature.melspectrogram(y=y, sr=sr, n_mels=cfg.N_MELS)
    spec = librosa.power_to_db(spec)
    return torch.tensor(spec).unsqueeze(0).float()


def audio_to_fixed_mel(audio_path: str) -> torch.Tensor:
    try:
        y, _ = librosa.load(audio_path, sr=cfg.SAMPLE_RATE, mono=True)
        mel = librosa.feature.melspectrogram(
            y=y, sr=cfg.SAMPLE_RATE,
            n_mels=cfg.N_MELS, n_fft=cfg.N_FFT, hop_length=cfg.HOP_LENGTH,
        )
        mel_db = librosa.power_to_db(mel, ref=np.max)
        mel_db = (mel_db - mel_db.min()) / (mel_db.max() - mel_db.min() + 1e-6)
        mel_t = torch.tensor(mel_db, dtype=torch.float32).unsqueeze(0)
        mel_t = F.interpolate(
            mel_t.unsqueeze(0),
            size=(cfg.N_MELS, cfg.MAX_FRAMES),
            mode="bilinear", align_corners=False,
        ).squeeze(0)
        return mel_t  # [1, 128, 128]
    except Exception:
        return torch.zeros(1, cfg.N_MELS, cfg.MAX_FRAMES)


# Dataset classes 

class MultimodalDataset(Dataset):
    def __init__(self, dataframe: pd.DataFrame, transform=None):
        self.df = dataframe.reset_index(drop=True)
        self.transform = transform

    def __len__(self):
        return len(self.df)

    def __getitem__(self, idx):
        row = self.df.iloc[idx]
        img_path   = os.path.join(cfg.DATASET_PATH, row["image_path"])
        audio_path = os.path.join(cfg.DATASET_PATH, row["audio_path"])
        label = 1 if row["label"] == "abnormal" else 0

        image = Image.open(img_path).convert("RGB")
        if self.transform:
            image = self.transform(image)

        spec = audio_to_spectrogram(audio_path)
        return image, spec, torch.tensor(label).long()


class CrackDataset(Dataset):
    def __init__(self, df: pd.DataFrame, mode: str = "train"):
        self.df   = df.reset_index(drop=True)
        self.mode = mode
        self.img_tf = (IMAGE_TRANSFORM_TRAIN if mode == "train"
                       else IMAGE_TRANSFORM_VAL)

    def __len__(self):
        return len(self.df)

    def _load_image(self, path: str) -> torch.Tensor:
        try:
            img = Image.open(path).convert("RGB")
            return self.img_tf(img)
        except Exception:
            return torch.zeros(3, cfg.IMG_SIZE, cfg.IMG_SIZE)

    def __getitem__(self, idx):
        row   = self.df.iloc[idx]
        image = self._load_image(row["img_full"])
        mel   = audio_to_fixed_mel(row["aud_full"])
        label = torch.tensor(row["label_enc"], dtype=torch.float32)
        return image, mel, label


# ── Data-loading helpers

def load_dataframe() -> pd.DataFrame:
    df = pd.read_csv(cfg.CSV_PATH)
    df["label_enc"] = df["label"].map({"abnormal": 1, "normal": 0})
    df["img_full"]  = df["image_path"].apply(lambda p: os.path.join(cfg.DATASET_PATH, p))
    df["aud_full"]  = df["audio_path"].apply(lambda p: os.path.join(cfg.DATASET_PATH, p))
    return df


def get_splits(df: pd.DataFrame):
    train_df, val_df = train_test_split(
        df,
        test_size=cfg.TEST_SIZE,
        stratify=df["label"],
        random_state=cfg.RANDOM_STATE,
    )
    return train_df.reset_index(drop=True), val_df.reset_index(drop=True)


def build_loaders(train_df: pd.DataFrame, val_df: pd.DataFrame):
    train_dataset = MultimodalDataset(train_df, transform=IMAGE_TRANSFORM_VAL)
    val_dataset   = MultimodalDataset(val_df,   transform=IMAGE_TRANSFORM_VAL)

    train_loader = DataLoader(
        train_dataset, batch_size=cfg.BATCH_SIZE,
        shuffle=True,  num_workers=cfg.NUM_WORKERS,
    )
    val_loader = DataLoader(
        val_dataset, batch_size=cfg.BATCH_SIZE,
        shuffle=False, num_workers=cfg.NUM_WORKERS,
    )
    return train_loader, val_loader, train_dataset, val_dataset
